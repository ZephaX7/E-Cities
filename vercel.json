{
  "name": "e-cities-frontend",
  "version": 2,
  "buildCommand": "echo 'Frontend assets ready'",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/(.*)",
      "destination": "/templates/dossier1/index.html"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/templates/dossier1/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "env": {
    "VITE_API_URL": "@vite_api_url"
  }
}
